# Postgres connection string. `docker compose up -d db` exposes urban/urban@localhost:5432/urban.
DATABASE_URL=postgresql://urban:urban@localhost:5432/urban

# Signs the host session cookie. 32+ chars. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Bearer token the cron container must present to POST /api/cron/sync.
CRON_SECRET=

# Base URL the cron job calls. Only used by docker-compose in the app profile.
APP_URL=http://localhost:3000

# Where cleaner turnover photos are written. Defaults to ./uploads if unset.
UPLOAD_DIR=./uploads
